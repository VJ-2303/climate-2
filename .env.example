# Twilio Carrier SMS Gateway Configuration
# Obtain credentials from your Twilio Console (https://console.twilio.com)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+12345678901

# Optional default recipient phone number for field alerts (E.164 format)
TWILIO_DEFAULT_RECIPIENT=+919443120101
